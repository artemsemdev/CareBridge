# Docker Compose
SQL_SA_PASSWORD=CareBridge_Dev_2026!
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# .NET services — ConnectionStrings__<Key> overrides the PLACEHOLDER in appsettings.Development.json.
# Source this file (`. .env`) before running `dotnet run` for any service that uses a database.
ConnectionStrings__CaseDb=Server=localhost,1433;Database=carebridge-case-db;User Id=sa;Password=CareBridge_Dev_2026!;TrustServerCertificate=True
ConnectionStrings__CarePlanDb=Server=localhost,1433;Database=carebridge-careplan-db;User Id=sa;Password=CareBridge_Dev_2026!;TrustServerCertificate=True
ConnectionStrings__ObservationDb=Server=localhost,1433;Database=carebridge-observation-db;User Id=sa;Password=CareBridge_Dev_2026!;TrustServerCertificate=True
ConnectionStrings__CareGapDb=Server=localhost,1433;Database=carebridge-caregap-db;User Id=sa;Password=CareBridge_Dev_2026!;TrustServerCertificate=True

# RabbitMQ credentials for .NET services
